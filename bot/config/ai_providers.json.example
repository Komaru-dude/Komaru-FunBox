    }
  },
  "model_routes": {},
  "fallbacks": {
    "free": {
      "max_chain": 2
    },
    "premium": {
      "max_chain": 3
    }
  },
  "healthchecks": {
    "poll_interval": 300,
    "success_cooldown": 43200,
    "failure_cooldown": 900,
    "models": {
      "claude-*": {
        "success_cooldown": 86400
      }
    }
  }
}