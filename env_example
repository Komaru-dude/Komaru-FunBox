# Пример .env файла для настройки бота
# Переименуйте в .env если будете использовать

# Токен API бота (можно взять тут: https://t.me/BotFather)
BOT_API_TOKEN=your_bot_api_token

# ID владельца (можно взять тут: https://t.me/getmyid_bot)
OWNER_ID=your_owner_id

# Ваши API_ID и API_HASH (можно взять тут: https://my.telegram.org/apps)
API_ID=your_api_id
API_HASH=your_api_hash

# Порт для Pyrogram бота, убедитесь что он ничем не занят
PYRO_PORT=8000

# Ваш url для апи нейросетей
API_URL=http://api.onlysq.ru/ai/v2
OPENAI_SDK_API_URL=http://api.onlysq.ru/ai/openai

# Апи ключ для onlysq (на момент написания не требуется)
ONLYSQ_API_KEY=openai

# Апи ключ для jigsaw нейросетей (можно взять тут: https://jigsawstack.com/dashboard/)
JIGSAW_API_KEY=your_api_key

# Апи ключ для https://www.weatherapi.com
WEATHER_API_KEY=your_api_key

# Включает работу бота ТОЛЬКО в одном/нескольких чатах указанных ниже (подробнее: https://komaru-dude.github.io/Komaru-FunBox/docs/setup/selfhost#1%EF%B8%8F%E2%83%A3-%D0%BE%D0%B3%D1%80%D0%B0%D0%BD%D0%B8%D1%87%D0%B5%D0%BD%D0%B8%D0%B5-%D1%80%D0%B0%D0%B1%D0%BE%D1%82%D1%8B-%D0%B2-%D0%B2%D1%8B%D0%B1%D1%80%D0%B0%D0%BD%D0%BD%D1%8B%D1%85-%D1%87%D0%B0%D1%82%D0%B0%D1%85)
SPECIFIC_CHAT=false
SPECIFIC_CHATS_ID=123456789,987654321

# Бд, не трогайте это
DB_NAME=DB_NAME
DB_USER=DB_USER
DB_PASSWORD=DB_PASSWORD
DB_HOST=localhost
DB_PORT=5432